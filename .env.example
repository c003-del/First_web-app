# Copy to .env.local and fill in. NEVER commit real secrets.
# Values prefixed NEXT_PUBLIC_ are exposed to the browser by design.

# Public site URL (used for auth redirects). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser, never import into client code.
# Used only by trusted server-side jobs (invites, media processing).
SUPABASE_SERVICE_ROLE_KEY=
